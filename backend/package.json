{
  "name": "depvault-api",
  "version": "0.1.0",
  "description": "DepVault scan API: inspects npm and PyPI packages before install and returns an Allow / Warn / Block verdict. Never executes package code.",
  "main": "server.js",
  "private": true,
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/VaikunthAnkola/DepVault.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:live": "LIVE_TESTS=1 node --test \"test/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "tar-stream": "^3.2.2",
    "yauzl": "^3.4.0"
  }
}
