# Copy to .env for local runs. On Render, set these under Environment.
# Never commit a real .env file. Do NOT set PORT on Render; it is provided.

NODE_ENV=production

# Comma-separated browser origins allowed to call the API (no trailing slash).
ALLOWED_ORIGINS=https://depvault.netlify.app,http://localhost:5173,http://127.0.0.1:5500

# Reverse proxies in front of the app. Render = 1.
TRUST_PROXY=1

# Abuse limits
RATE_LIMIT_SCANS_PER_MIN=10
RATE_LIMIT_REQUESTS_PER_MIN=120
MAX_ACTIVE_SCANS=3
MAX_QUEUED_SCANS=20

# Optional local AI. Leave empty on Render: it does not run Ollama.
# Example for a self-hosted box: OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_URL=
OLLAMA_MODEL=gemma2:2b
